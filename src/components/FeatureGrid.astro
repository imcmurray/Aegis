---
const features = [
  { icon: 'M3 4h18v16H3zM3 9h18M8 13h4', title: 'Logins, notes, folders', text: 'Entries with URLs, usernames, custom fields and labels, organised the way you think.' },
  { icon: 'M12 3a9 9 0 100 18 9 9 0 000-18zM12 7v5l3 2', title: 'One-time codes', text: 'TOTP lives next to the password it protects, so two-factor is one copy away.' },
  { icon: 'M4 19h16M6 15l4-6 4 4 4-7', title: 'Generator and health', text: 'Strong passwords on demand, and weak, reused or old ones surfaced in one view, computed on your device.' },
  { icon: 'M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7zM9 12l2 2 4-4', title: 'Recovery Kit', text: 'Export a kit once and keep its recovery secret separately. Together they let you set a new passphrase on the same vault.' },
  { icon: 'M12 4v11M8 11l4 4 4-4M4 19h16', title: 'Encrypted backups', text: 'A sealed .aegis file restores in any browser and never exposes your live keys, because a restore mints a fresh identity.' },
  { icon: 'M3 5h12v9H3zM13 10h8v10h-8z', title: 'Multi-device sync', text: 'Encrypted revisions signed with both Ed25519 and ML-DSA-65, so a break in either scheme alone cannot forge a change.' },
  { icon: 'M4 12h16M14 6l6 6-6 6', title: 'Share an entry', text: 'Seal one entry to another Aegis user under X25519 and ML-KEM-768 together. Only the named sender can be opened.' },
  { icon: 'M20 12a8 8 0 11-2.3-5.7M20 4v5h-5', title: 'Key rotation', text: 'Rotate your whole identity in one step. Old shares stop opening, and the vault is never decrypted in bulk.' },
  { icon: 'M5 12a7 7 0 0114 0v5H5zM9 21h6', title: 'Works offline', text: 'The vault is yours in the browser, on a plane, or on a machine that never touches the internet.' },
];
---
<div class="grid">
  {features.map((f) => (
    <div class="feat">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={f.icon} /></svg>
      <h3>{f.title}</h3>
      <p>{f.text}</p>
    </div>
  ))}
</div>
<style>
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .feat { background: var(--surface); padding: 1.5rem; display: grid; gap: .5rem; align-content: start; }
  svg { width: 22px; height: 22px; color: var(--accent); }
  h3 { font-size: .98rem; font-weight: 600; }
  p { font-size: .88rem; color: var(--text-2); }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
