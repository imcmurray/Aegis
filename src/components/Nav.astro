---
import Logo from './Logo.astro';
import { nav, site } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<nav class="nav" aria-label="Primary">
  <div class="wrap">
    <a class="brand" href="/"><Logo /> Aegis</a>
    <div class="links" id="nav-links">
      {nav.map((item) => (
        <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
      ))}
    </div>
    <div class="cta">
      <button class="theme" type="button" id="theme-toggle" aria-label="Toggle colour theme" title="Toggle theme">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1"/></svg>
      </button>
      <a class="login" href="/support">Support</a>
      <a class="btn btn-primary" href={site.appUrl}>Open vault</a>
      <button class="menu" type="button" id="nav-menu" aria-expanded="false" aria-controls="nav-links" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const dark = root.dataset.theme === 'dark' || (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    root.dataset.theme = dark ? 'light' : 'dark';
    try { localStorage.setItem('aegis-theme', root.dataset.theme); } catch {}
  });
  const menu = document.getElementById('nav-menu');
  const links = document.getElementById('nav-links');
  menu?.addEventListener('click', () => {
    const open = links?.classList.toggle('open');
    menu.setAttribute('aria-expanded', String(!!open));
  });
</script>

<style>
  .nav { position: sticky; top: 0; z-index: 10; backdrop-filter: blur(12px); background: color-mix(in srgb, var(--ink) 82%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--mist) 8%, transparent); color: var(--mist); }
  .nav .wrap { display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 2rem; position: relative; }
  .brand { display: inline-flex; align-items: center; gap: .55rem; font-weight: 600; letter-spacing: -.02em; font-size: 1.05rem; color: var(--mist); }
  .links { display: flex; gap: 1.75rem; font-size: .92rem; color: var(--mist-2); }
  .links a:hover, .links a[aria-current="page"] { color: var(--mist); }
  .cta { display: flex; align-items: center; gap: 1.1rem; font-size: .92rem; }
  .login { color: var(--mist-2); }
  .login:hover { color: var(--mist); }
  .cta .btn { padding: .55rem 1rem; font-size: .88rem; }
  .theme { background: none; border: 1px solid var(--line-dark); color: var(--mist-2); width: 32px; height: 32px; border-radius: 8px; display: grid; place-items: center; cursor: pointer; }
  .theme:hover { color: var(--mist); border-color: var(--mist-2); }
  .menu { display: none; background: none; border: 0; width: 36px; height: 36px; padding: 6px; cursor: pointer; flex-direction: column; justify-content: space-around; }
  .menu span { display: block; height: 2px; background: var(--mist); border-radius: 2px; }
  @media (max-width: 900px) {
    .links { display: none; position: absolute; top: 64px; left: 0; right: 0; flex-direction: column; gap: 0; background: var(--ink); border-bottom: 1px solid var(--line-dark); padding: .5rem 0 1rem; }
    .links.open { display: flex; }
    .links a { padding: .8rem 1.5rem; }
    .login { display: none; }
    .menu { display: flex; }
  }
</style>
